digraph "e1_clases_ganaderia" {
  graph [fontname="Helvetica", fontsize=12, bgcolor=white, pad=0.2, rankdir=TB, nodesep=0.4, ranksep=0.55, newrank=true];
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=10, color="#555555", penwidth=1.1];
  "Usuario" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">«AbstractUser»</FONT><BR/><FONT COLOR="white"><B>Usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- telefono: str {único, login}</FONT><BR/><FONT POINT-SIZE="10">- rol: RolUsuario</FONT><BR/><FONT POINT-SIZE="10">- is_staff: bool</FONT><BR/><FONT POINT-SIZE="10">- created_at / updated_at: datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">+ administra_tienda(): bool</FONT></TD></TR></TABLE>>];
  "Animal" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>Animal</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- uid: UUID {único}</FONT><BR/><FONT POINT-SIZE="10">- arete: str {único en el hato}</FONT><BR/><FONT POINT-SIZE="10">- especie: Especie</FONT><BR/><FONT POINT-SIZE="10">- sexo: Sexo</FONT><BR/><FONT POINT-SIZE="10">- fecha_nacimiento: date</FONT><BR/><FONT POINT-SIZE="10">- nombre: str</FONT><BR/><FONT POINT-SIZE="10">- raza: str</FONT><BR/><FONT POINT-SIZE="10">- foto: Imagen</FONT><BR/><FONT POINT-SIZE="10">- estado: EstadoAnimal</FONT><BR/><FONT POINT-SIZE="10">- fecha_estado: datetime</FONT><BR/><FONT POINT-SIZE="10">- motivo_estado: str</FONT><BR/><FONT POINT-SIZE="10">- peso_nacimiento_kg: decimal</FONT><BR/><FONT POINT-SIZE="10">- longitud_mecha_nacimiento_cm: decimal</FONT><BR/><FONT POINT-SIZE="10">- sync_status: SyncStatus</FONT><BR/><FONT POINT-SIZE="10">- updated_at: datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">+ clean(): no es su propio padre/madre</FONT><BR/><FONT POINT-SIZE="10">+ save(): registra fecha_estado</FONT><BR/><FONT POINT-SIZE="10">+ /categoria_edad: str</FONT><BR/><FONT POINT-SIZE="10">+ /edad_detallada: str</FONT></TD></TR></TABLE>>];
  "Produccion" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">esquila</FONT><BR/><FONT COLOR="white"><B>Produccion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- uid: UUID {único}</FONT><BR/><FONT POINT-SIZE="10">- numero_esquila: int</FONT><BR/><FONT POINT-SIZE="10">- fecha_esquila: date</FONT><BR/><FONT POINT-SIZE="10">- peso_vellon_lb: decimal</FONT><BR/><FONT POINT-SIZE="10">- longitud_mecha_cm: decimal</FONT><BR/><FONT POINT-SIZE="10">- observaciones: str</FONT><BR/><FONT POINT-SIZE="10">- sync_status: SyncStatus</FONT></TD></TR></TABLE>>];
  "AnalisisFibra" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>AnalisisFibra</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- dmf: decimal (µm)</FONT><BR/><FONT POINT-SIZE="10">- cv: decimal (%)</FONT><BR/><FONT POINT-SIZE="10">- desviacion_estandar: decimal (µm)</FONT><BR/><FONT POINT-SIZE="10">- factor_confort: decimal (%)</FONT><BR/><FONT POINT-SIZE="10">- indice_curvatura: decimal (°/mm)</FONT><BR/><FONT POINT-SIZE="10">- fecha_analisis: date</FONT><BR/><FONT POINT-SIZE="10">- observaciones: str</FONT></TD></TR></TABLE>>];
  "Raza" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>Raza</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- nombre: str</FONT><BR/><FONT POINT-SIZE="10">- especie: Especie</FONT><BR/><FONT POINT-SIZE="10">{único: nombre + especie}</FONT></TD></TR></TABLE>>];
  "FotoAnimal" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">galería</FONT><BR/><FONT COLOR="white"><B>FotoAnimal</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- imagen: Imagen</FONT><BR/><FONT POINT-SIZE="10">- descripcion: str</FONT><BR/><FONT POINT-SIZE="10">- orden: int</FONT></TD></TR></TABLE>>];
  "ServiciosGenealogia" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">«servicio»</FONT><BR/><FONT COLOR="white"><B>ServiciosGenealogia</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">+ build_tree(animal, ≤ 3 generaciones): dict</FONT><BR/><FONT POINT-SIZE="10">+ calcular_coi(padre, madre, max_depth = 3): COI</FONT></TD></TR></TABLE>>];
  "Enumeraciones" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#5B5B8F" CELLSPACING="0"><TR><TD BGCOLOR="#5B5B8F" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">«enumeraciones»</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F3FA"><FONT POINT-SIZE="10"><B>RolUsuario</B>: ADMINISTRADOR, CRIADOR</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F3FA"><FONT POINT-SIZE="10"><B>Especie</B>: ALPACA, LLAMA, OVINO</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F3FA"><FONT POINT-SIZE="10"><B>Sexo</B>: HEMBRA, MACHO</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F3FA"><FONT POINT-SIZE="10"><B>EstadoAnimal</B>: VIVO, VENDIDO, MUERTO</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F3FA"><FONT POINT-SIZE="10"><B>SyncStatus</B>: PENDIENTE, SINCRONIZADO, ERROR</FONT></TD></TR></TABLE>>];
  "Animal" -> "Usuario" [arrowhead=open, arrowsize=0.7, taillabel="0..*", headlabel="1", labeldistance=1.6, labelfontsize=10, label=<<FONT POINT-SIZE="10">registrado por</FONT>>];
  "Animal" -> "Animal" [arrowhead=open, arrowsize=0.7, taillabel="0..*", headlabel="0..1", labeldistance=1.6, labelfontsize=10, label=<<FONT POINT-SIZE="10">padre / madre</FONT>>];
  "Animal" -> "Produccion" [dir=back, arrowtail=diamond, arrowsize=1.1, taillabel="1", headlabel="0..*", labeldistance=1.6, labelfontsize=10];
  "Produccion" -> "AnalisisFibra" [dir=back, arrowtail=diamond, arrowsize=1.1, taillabel="1", headlabel="0..1", labeldistance=1.6, labelfontsize=10];
  "Animal" -> "FotoAnimal" [dir=back, arrowtail=diamond, arrowsize=1.1, taillabel="1", headlabel="0..*", labeldistance=1.6, labelfontsize=10];
  "Animal" -> "Raza" [style=dashed, arrowhead=open, arrowsize=0.7, taillabel="", headlabel="", labeldistance=1.6, labelfontsize=10, label=<<FONT POINT-SIZE="10">raza (catálogo)</FONT>>];
  "ServiciosGenealogia" -> "Animal" [style=dashed, arrowhead=open, arrowsize=0.7, taillabel="", headlabel="", labeldistance=1.6, labelfontsize=10, label=<<FONT POINT-SIZE="10">«usa»</FONT>>];
  {rank=same; ServiciosGenealogia; Enumeraciones}
  {rank=same; Usuario; Raza}
}
