digraph "e1_c4" {
  graph [fontname="Helvetica", fontsize=12, bgcolor=white, pad=0.2, rankdir=TB, nodesep=0.45, ranksep=0.65, newrank=true];
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=10, color="#555555", penwidth=1.1];

  cri [shape=box, style="rounded,filled", fillcolor="#08427B", fontcolor=white, color="#073B6F", label=<<B>Criador</B><BR/><FONT POINT-SIZE="9">[Persona]</FONT><BR/><FONT POINT-SIZE="10">personal de campo</FONT><BR/><FONT POINT-SIZE="10">registra el hato</FONT>>];
  adm [shape=box, style="rounded,filled", fillcolor="#08427B", fontcolor=white, color="#073B6F", label=<<B>Administrador</B><BR/><FONT POINT-SIZE="9">[Persona]</FONT><BR/><FONT POINT-SIZE="10">usuario único: gestiona</FONT><BR/><FONT POINT-SIZE="10">usuarios, tienda y pagos</FONT>>];
  com [shape=box, style="rounded,filled", fillcolor="#08427B", fontcolor=white, color="#073B6F", label=<<B>Comprador</B><BR/><FONT POINT-SIZE="9">[Persona]</FONT><BR/><FONT POINT-SIZE="10">compra sin cuenta</FONT>>];
  subgraph cluster_sys { label=<<B>Sistema Wawa Pacocha</B><BR/><FONT POINT-SIZE="9">[Sistema de software]</FONT>>; style="dashed,rounded"; color="#444444"; fontsize=13;
    app [shape=box, style="rounded,filled", fillcolor="#438DD5", fontcolor=white, color="#3C7FC0", label=<<B>App móvil GeneApp</B><BR/><FONT POINT-SIZE="9">[Contenedor: Flutter]</FONT><BR/><FONT POINT-SIZE="10">registro del hato offline-first,</FONT><BR/><FONT POINT-SIZE="10">árbol, esquilas, reportes</FONT>>];
    web [shape=box, style="rounded,filled", fillcolor="#438DD5", fontcolor=white, color="#3C7FC0", label=<<B>Tienda web</B><BR/><FONT POINT-SIZE="9">[Contenedor: Next.js]</FONT><BR/><FONT POINT-SIZE="10">catálogo, trazabilidad,</FONT><BR/><FONT POINT-SIZE="10">pedidos y comprobantes</FONT>>];
    pan [shape=box, style="rounded,filled", fillcolor="#438DD5", fontcolor=white, color="#3C7FC0", label=<<B>Panel de administración</B><BR/><FONT POINT-SIZE="9">[Contenedor: Django Admin]</FONT><BR/><FONT POINT-SIZE="10">usuarios, catálogo, stock,</FONT><BR/><FONT POINT-SIZE="10">pedidos, pagos, contenido</FONT>>];
    api [shape=box, style="rounded,filled", fillcolor="#438DD5", fontcolor=white, color="#3C7FC0", label=<<B>API REST</B><BR/><FONT POINT-SIZE="9">[Contenedor: Django REST Framework]</FONT><BR/><FONT POINT-SIZE="10">lógica de negocio, JWT,</FONT><BR/><FONT POINT-SIZE="10">sincronización, reservas de stock</FONT>>];
    db [shape=box, style="rounded,filled", fillcolor="#438DD5", fontcolor=white, color="#3C7FC0", shape=cylinder, label=<<B>Base de datos</B><BR/><FONT POINT-SIZE="9">[Contenedor: MySQL 8]</FONT><BR/><FONT POINT-SIZE="10">hato, tienda y contenido</FONT>>];
    med [shape=box, style="rounded,filled", fillcolor="#438DD5", fontcolor=white, color="#3C7FC0", shape=folder, label=<<B>Archivos subidos</B><BR/><FONT POINT-SIZE="9">[Contenedor: volumen media]</FONT><BR/><FONT POINT-SIZE="10">fotos y comprobantes</FONT>>];
  }
  yape [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor=white, color="#8A8A8A", label=<<B>Yape / Plin</B><BR/><FONT POINT-SIZE="9">[Sistema externo]</FONT><BR/><FONT POINT-SIZE="10">billeteras digitales;</FONT><BR/><FONT POINT-SIZE="10">pago manual, sin integración</FONT>>];
  wsp [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor=white, color="#8A8A8A", label=<<B>WhatsApp</B><BR/><FONT POINT-SIZE="9">[Sistema externo]</FONT><BR/><FONT POINT-SIZE="10">coordinación opcional del pedido</FONT>>];
  cri -> app [label="registra y consulta"];
  com -> web [label="compra y sigue su pedido"];
  adm -> pan [label="administra"];
  app -> api [label="JSON/HTTPS + JWT"];
  web -> api [label="JSON/HTTPS"];
  pan -> api [label="ORM y servicios", style=dashed];
  api -> db [label="lee y escribe (ORM)"];
  api -> med [label="guarda archivos"];
  com -> yape [label="transfiere el pago"];
  web -> wsp [label="envía el detalle (opcional)", style=dashed];
  {rank=same; cri; com; adm}
  {rank=same; yape; wsp}

}
