digraph "e2_er_tienda1" {
  graph [rankdir=TB, fontname="Helvetica", fontsize=20, labelloc=t, nodesep=0.5, ranksep=0.55, pad=0.2, bgcolor=white, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=12];
  edge [color="#555555", penwidth=1.2, arrowsize=1.0, fontname="Helvetica"];
  "artesanos" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>artesanos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">nombre</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">contacto</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">localidad</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">activo</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">tinyint(1)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +2 columnas</I></FONT></TD></TR></TABLE>>];
  "lotes" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>lotes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">codigo_lote</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">tipo_fibra</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">fecha_ingreso</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">cantidad_kg</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">decimal(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">animal_id <I>(opt)</I></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">produccion_id <I>(opt)</I></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +2 columnas</I></FONT></TD></TR></TABLE>>];
  "procesos_lote" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>procesos_lote</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">etapa</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">orden_secuencia</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">fecha_proceso</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">lote_id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +2 columnas</I></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#8A5A00" POINT-SIZE="10"><B>UK</B> (lote_id, orden_secuencia)</FONT></TD></TR></TABLE>>];
  "productos" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>productos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">nombre</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">slug</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(170)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">categoria</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">unidad_venta</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">activo</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">artesano_id <I>(opt)</I></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">lote_id <I>(opt)</I></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +7 columnas</I></FONT></TD></TR></TABLE>>];
  "imagenes_producto" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>imagenes_producto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">orden</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">producto_id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +2 columnas</I></FONT></TD></TR></TABLE>>];
  "variantes_producto" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>variantes_producto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">talla</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">color</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">tipo_prenda</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">sku</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">precio_base</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">stock</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">stock_reservado</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">producto_id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +2 columnas</I></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#8A5A00" POINT-SIZE="10"><B>UK</B> (producto_id, talla, color, tipo_prenda)</FONT></TD></TR></TABLE>>];
  "precios_temporada" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>precios_temporada</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">nombre_temporada</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">precio_especial</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">fecha_inicio</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">fecha_fin</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">variante_id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +1 columnas</I></FONT></TD></TR></TABLE>>];
  "animales" [label=<<TABLE BORDER="1" COLOR="#8C8C8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#8C8C8C" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>animales</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0">id</TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0">arete</TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#767676" POINT-SIZE="10">varchar(50)</FONT></TD></TR></TABLE>>];
  "producciones" [label=<<TABLE BORDER="1" COLOR="#8C8C8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#8C8C8C" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>producciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0">id</TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0">animal_id</TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR></TABLE>>];
  "animales" -> "lotes" [dir=both, arrowtail=teeodot, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">animal_id</FONT>>];
  "producciones" -> "lotes" [dir=both, arrowtail=teeodot, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">produccion_id</FONT>>];
  "lotes" -> "procesos_lote" [dir=both, arrowtail=teetee, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">lote_id</FONT>>];
  "artesanos" -> "productos" [dir=both, arrowtail=teeodot, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">artesano_id</FONT>>];
  "lotes" -> "productos" [dir=both, arrowtail=teeodot, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">lote_id</FONT>>];
  "productos" -> "imagenes_producto" [dir=both, arrowtail=teetee, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">producto_id</FONT>>];
  "productos" -> "variantes_producto" [dir=both, arrowtail=teetee, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">producto_id</FONT>>];
  "variantes_producto" -> "precios_temporada" [dir=both, arrowtail=teetee, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">variante_id</FONT>>];
  "animales" -> "producciones" [dir=both, arrowtail=teetee, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">animal_id</FONT>>];
  {rank=same; animales; producciones; artesanos}
  {rank=same; lotes; productos}
  {rank=same; procesos_lote; imagenes_producto}
  {rank=same; variantes_producto; precios_temporada}
  procesos_lote -> variantes_producto [style=invis]; imagenes_producto -> precios_temporada [style=invis]
}