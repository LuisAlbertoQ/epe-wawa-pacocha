digraph "e1_clases_tienda2" {
  graph [fontname="Helvetica", fontsize=12, bgcolor=white, pad=0.2, rankdir=TB, nodesep=0.35, ranksep=0.55, newrank=true];
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=10, color="#555555", penwidth=1.1];
  "Pedido" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>Pedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- codigo: str {único, WP-#####}</FONT><BR/><FONT POINT-SIZE="10">- cliente_nombre: str</FONT><BR/><FONT POINT-SIZE="10">- cliente_contacto: str</FONT><BR/><FONT POINT-SIZE="10">- cliente_referencia: str</FONT><BR/><FONT POINT-SIZE="10">- estado: EstadoPedido</FONT><BR/><FONT POINT-SIZE="10">- total: decimal</FONT><BR/><FONT POINT-SIZE="10">- motivo_comprobante: str</FONT><BR/><FONT POINT-SIZE="10">- created_at: datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">+ /reserva_expira: datetime</FONT></TD></TR></TABLE>>];
  "DetallePedido" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>DetallePedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- cantidad: int {&gt; 0}</FONT><BR/><FONT POINT-SIZE="10">- precio_unitario: decimal {histórico}</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">+ /subtotal: decimal</FONT></TD></TR></TABLE>>];
  "Pago" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>Pago</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- metodo: MetodoPago</FONT><BR/><FONT POINT-SIZE="10">- comprobante_imagen: Imagen {privada}</FONT><BR/><FONT POINT-SIZE="10">- estado: EstadoPago</FONT><BR/><FONT POINT-SIZE="10">- fecha_confirmacion: datetime</FONT><BR/><FONT POINT-SIZE="10">- observaciones_admin: str</FONT><BR/><FONT POINT-SIZE="10">- gateway_transaccion_id: str {'' hasta integrar pasarela}</FONT><BR/><FONT POINT-SIZE="10">- huella_comprobante: str {SHA-256}</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">+ comprobantes_iguales(): Pago[*]</FONT><BR/><FONT POINT-SIZE="10">+ /url_comprobante: vista protegida</FONT></TD></TR></TABLE>>];
  "ServiciosPedido" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">«servicio» tienda/services.py</FONT><BR/><FONT COLOR="white"><B>ServiciosPedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">+ crear_pedido(cliente, items): Pedido</FONT><BR/><FONT POINT-SIZE="10">+ registrar_pago(pedido, metodo, comprobante)</FONT><BR/><FONT POINT-SIZE="10">+ confirmar_pago(pago, usuario)</FONT><BR/><FONT POINT-SIZE="10">+ rechazar_pago(pago, usuario)</FONT><BR/><FONT POINT-SIZE="10">+ pedir_otro_comprobante(pago, motivo)</FONT><BR/><FONT POINT-SIZE="10">+ marcar_entregado(pedido)</FONT><BR/><FONT POINT-SIZE="10">+ cancelar_pedido(pedido)</FONT><BR/><FONT POINT-SIZE="10">+ liberar_reserva(pedido)</FONT></TD></TR></TABLE>>];
  "AnimalEnVenta" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>AnimalEnVenta</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- precio: decimal</FONT><BR/><FONT POINT-SIZE="10">- proposito: reproductor | cria | fibra</FONT><BR/><FONT POINT-SIZE="10">- titulo: str</FONT><BR/><FONT POINT-SIZE="10">- descripcion: str</FONT><BR/><FONT POINT-SIZE="10">- imagen: Imagen</FONT><BR/><FONT POINT-SIZE="10">- destacado: bool</FONT><BR/><FONT POINT-SIZE="10">- orden: int</FONT><BR/><FONT POINT-SIZE="10">- estado: no_en_venta | disponible | reservado | vendido</FONT></TD></TR></TABLE>>];
  "ConfiguracionTienda" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">«singleton» id = 1</FONT><BR/><FONT COLOR="white"><B>ConfiguracionTienda</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- horas_reserva: int = 48</FONT><BR/><FONT POINT-SIZE="10">- telefono_yape / telefono_plin: str</FONT><BR/><FONT POINT-SIZE="10">- pedido_por_whatsapp: bool</FONT><BR/><FONT POINT-SIZE="10">- tema_temporada · mapa_* · nosotros_*</FONT><BR/><FONT POINT-SIZE="10">- … portada, SEO, trazabilidad</FONT></TD></TR></TABLE>>];
  "EventoFeria" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>EventoFeria</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- titulo, fecha_evento, fecha_fin</FONT><BR/><FONT POINT-SIZE="10">- ubicacion, enlace, destacado</FONT></TD></TR></TABLE>>];
  "Publicacion" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>Publicacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- titulo, resumen, fuente</FONT><BR/><FONT POINT-SIZE="10">- medio, fecha, enlace</FONT></TD></TR></TABLE>>];
  "VarianteProducto" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#8C8C8C" CELLSPACING="0"><TR><TD BGCOLOR="#8C8C8C" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">«tienda 1/2»</FONT><BR/><FONT COLOR="white"><B>VarianteProducto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="10">- sku</FONT><BR/><FONT POINT-SIZE="10">- stock</FONT><BR/><FONT POINT-SIZE="10">- stock_reservado</FONT></TD></TR></TABLE>>];
  "Usuario" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#8C8C8C" CELLSPACING="0"><TR><TD BGCOLOR="#8C8C8C" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">«ganadería»</FONT><BR/><FONT COLOR="white"><B>Usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="10">- rol = ADMINISTRADOR</FONT></TD></TR></TABLE>>];
  "Animal" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#8C8C8C" CELLSPACING="0"><TR><TD BGCOLOR="#8C8C8C" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">«ganadería»</FONT><BR/><FONT COLOR="white"><B>Animal</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="10">- arete</FONT><BR/><FONT POINT-SIZE="10">- padre / madre</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="10">+ producciones → análisis</FONT></TD></TR></TABLE>>];
  "Enumeraciones" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#5B5B8F" CELLSPACING="0"><TR><TD BGCOLOR="#5B5B8F" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">«enumeraciones»</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F3FA"><FONT POINT-SIZE="10"><B>EstadoPedido</B>: PENDIENTE, PAGADO, ENTREGADO, CANCELADO</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F3FA"><FONT POINT-SIZE="10"><B>EstadoPago</B>: PENDIENTE, CONFIRMADO, RECHAZADO</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F3FA"><FONT POINT-SIZE="10"><B>MetodoPago</B>: YAPE, PLIN</FONT></TD></TR></TABLE>>];
  "Pedido" -> "DetallePedido" [dir=back, arrowtail=diamond, arrowsize=1.1, taillabel="1", headlabel="1..*", labeldistance=1.6, labelfontsize=10];
  "DetallePedido" -> "VarianteProducto" [arrowhead=open, arrowsize=0.7, taillabel="0..*", headlabel="1", labeldistance=1.6, labelfontsize=10];
  "Pedido" -> "Pago" [dir=back, arrowtail=diamond, arrowsize=1.1, taillabel="1", headlabel="0..1", labeldistance=1.6, labelfontsize=10];
  "Pago" -> "Usuario" [arrowhead=open, arrowsize=0.7, taillabel="0..*", headlabel="0..1", labeldistance=1.6, labelfontsize=10, label=<<FONT POINT-SIZE="10">confirmado_por</FONT>>];
  "AnimalEnVenta" -> "Animal" [arrowhead=open, arrowsize=0.7, taillabel="0..1", headlabel="1", labeldistance=1.6, labelfontsize=10, label=<<FONT POINT-SIZE="10">publica (sin copiar datos)</FONT>>];
  "ServiciosPedido" -> "Pedido" [style=dashed, arrowhead=open, arrowsize=0.7, taillabel="", headlabel="", labeldistance=1.6, labelfontsize=10, label=<<FONT POINT-SIZE="10">«gestiona»</FONT>>];
  "ServiciosPedido" -> "VarianteProducto" [style=dashed, arrowhead=open, arrowsize=0.7, taillabel="", headlabel="", labeldistance=1.6, labelfontsize=10, label=<<FONT POINT-SIZE="10">reserva / descuenta stock</FONT>>];
  "ServiciosPedido" -> "ConfiguracionTienda" [style=dashed, arrowhead=open, arrowsize=0.7, taillabel="", headlabel="", labeldistance=1.6, labelfontsize=10, label=<<FONT POINT-SIZE="10">horas_reserva</FONT>>];
  {rank=same; Pedido; AnimalEnVenta}
  {rank=same; ServiciosPedido; Enumeraciones}
  {rank=same; Usuario; VarianteProducto; EventoFeria; Publicacion}
  Animal -> EventoFeria [style=invis];
}
