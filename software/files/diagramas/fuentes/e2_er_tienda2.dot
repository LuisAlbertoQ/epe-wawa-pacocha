digraph "e2_er_tienda2" {
  graph [rankdir=TB, fontname="Helvetica", fontsize=20, labelloc=t, nodesep=0.5, ranksep=0.7, pad=0.2, bgcolor=white, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=12];
  edge [color="#555555", penwidth=1.2, arrowsize=1.0, fontname="Helvetica"];
  "pedidos" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>pedidos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">codigo</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">cliente_nombre</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">cliente_contacto</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">cliente_referencia</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">estado</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">total</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">decimal(10,2)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +3 columnas</I></FONT></TD></TR></TABLE>>];
  "detalle_pedido" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>detalle_pedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">cantidad</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">precio_unitario</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">pedido_id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">variante_id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR></TABLE>>];
  "pagos" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>pagos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">metodo</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">comprobante_imagen</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">estado</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">fecha_confirmacion</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">huella_comprobante</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">confirmado_por_id <I>(opt)</I></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT> <FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">pedido_id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +3 columnas</I></FONT></TD></TR></TABLE>>];
  "eventos_feria" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>eventos_feria</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">titulo</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">fecha_evento</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">ubicacion</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">activo</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">destacado</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">tinyint(1)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +6 columnas</I></FONT></TD></TR></TABLE>>];
  "publicaciones" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>publicaciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">titulo</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(180)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">fuente</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">medio</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">fecha</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">enlace</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(500)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +5 columnas</I></FONT></TD></TR></TABLE>>];
  "variantes_producto" [label=<<TABLE BORDER="1" COLOR="#8C8C8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#8C8C8C" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>variantes_producto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0">id</TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0">sku</TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#767676" POINT-SIZE="10">varchar(40)</FONT></TD></TR></TABLE>>];
  "usuarios" [label=<<TABLE BORDER="1" COLOR="#8C8C8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#8C8C8C" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>usuarios</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0">id</TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"> </TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0">rol</TD><TD ALIGN="LEFT" BGCOLOR="#F0F0F0"><FONT COLOR="#767676" POINT-SIZE="10">varchar(20)</FONT></TD></TR></TABLE>>];
  "pedidos" -> "detalle_pedido" [dir=both, arrowtail=teetee, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">pedido_id</FONT>>];
  "variantes_producto" -> "detalle_pedido" [dir=both, arrowtail=teetee, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">variante_id</FONT>>];
  "usuarios" -> "pagos" [dir=both, arrowtail=teeodot, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">confirmado_por_id</FONT>>];
  "pedidos" -> "pagos" [dir=both, arrowtail=teetee, arrowhead=teeodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">pedido_id</FONT>>];
  {rank=same; pedidos; variantes_producto; usuarios}
  {rank=same; eventos_feria; publicaciones}
  pagos -> eventos_feria [style=invis];
}