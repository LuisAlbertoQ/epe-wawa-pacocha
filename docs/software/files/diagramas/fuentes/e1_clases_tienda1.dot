digraph "e1_clases_tienda1" {
  graph [fontname="Helvetica", fontsize=12, bgcolor=white, pad=0.2, rankdir=TB, nodesep=0.4, ranksep=0.55, newrank=true];
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=10, color="#555555", penwidth=1.1];
  "Artesano" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>Artesano</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- nombre: str</FONT><BR/><FONT POINT-SIZE="10">- contacto: str</FONT><BR/><FONT POINT-SIZE="10">- localidad: str</FONT><BR/><FONT POINT-SIZE="10">- activo: bool</FONT></TD></TR></TABLE>>];
  "Lote" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>Lote</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- codigo_lote: str {único}</FONT><BR/><FONT POINT-SIZE="10">- tipo_fibra: TipoFibra</FONT><BR/><FONT POINT-SIZE="10">- fecha_ingreso: date</FONT><BR/><FONT POINT-SIZE="10">- cantidad_kg: decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">+ clean(): especie del animal = tipo_fibra;</FONT><BR/><FONT POINT-SIZE="10">  esquila del mismo animal</FONT></TD></TR></TABLE>>];
  "ProcesoLote" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>ProcesoLote</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- etapa: EtapaProceso</FONT><BR/><FONT POINT-SIZE="10">- orden_secuencia: int</FONT><BR/><FONT POINT-SIZE="10">- fecha_proceso: date</FONT><BR/><FONT POINT-SIZE="10">- observaciones: str</FONT><BR/><FONT POINT-SIZE="10">{único: lote + orden}</FONT></TD></TR></TABLE>>];
  "Producto" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>Producto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- nombre: str</FONT><BR/><FONT POINT-SIZE="10">- slug: str {único}</FONT><BR/><FONT POINT-SIZE="10">- descripcion: str</FONT><BR/><FONT POINT-SIZE="10">- categoria: CategoriaProducto</FONT><BR/><FONT POINT-SIZE="10">- unidad_venta: UnidadVenta</FONT><BR/><FONT POINT-SIZE="10">- imagen_principal: Imagen</FONT><BR/><FONT POINT-SIZE="10">- activo: bool</FONT><BR/><FONT POINT-SIZE="10">- destacado: bool</FONT><BR/><FONT POINT-SIZE="10">- orden: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">+ /tiene_stock: bool</FONT><BR/><FONT POINT-SIZE="10">+ /precio_desde: decimal</FONT></TD></TR></TABLE>>];
  "ImagenProducto" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>ImagenProducto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- imagen: Imagen</FONT><BR/><FONT POINT-SIZE="10">- orden: int</FONT></TD></TR></TABLE>>];
  "VarianteProducto" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>VarianteProducto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- talla: str</FONT><BR/><FONT POINT-SIZE="10">- color: str</FONT><BR/><FONT POINT-SIZE="10">- tipo_prenda: str</FONT><BR/><FONT POINT-SIZE="10">- sku: str {único}</FONT><BR/><FONT POINT-SIZE="10">- precio_base: decimal</FONT><BR/><FONT POINT-SIZE="10">- stock: int</FONT><BR/><FONT POINT-SIZE="10">- stock_reservado: int {≤ stock}</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">+ /stock_disponible: int</FONT><BR/><FONT POINT-SIZE="10">+ /temporada_vigente: PrecioTemporada</FONT><BR/><FONT POINT-SIZE="10">+ /precio_vigente: decimal</FONT></TD></TR></TABLE>>];
  "PrecioTemporada" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#1F3864" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864" CELLPADDING="4"><FONT COLOR="white"><B>PrecioTemporada</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT POINT-SIZE="10">- nombre_temporada: str</FONT><BR/><FONT POINT-SIZE="10">- precio_especial: decimal</FONT><BR/><FONT POINT-SIZE="10">- fecha_inicio: date</FONT><BR/><FONT POINT-SIZE="10">- fecha_fin: date {≥ inicio}</FONT><BR/><FONT POINT-SIZE="10">- activo: bool</FONT></TD></TR></TABLE>>];
  "Animal" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#8C8C8C" CELLSPACING="0"><TR><TD BGCOLOR="#8C8C8C" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">«ganadería»</FONT><BR/><FONT COLOR="white"><B>Animal</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="10">- arete</FONT><BR/><FONT POINT-SIZE="10">- especie</FONT><BR/><FONT POINT-SIZE="10">- raza</FONT></TD></TR></TABLE>>];
  "Produccion" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#8C8C8C" CELLSPACING="0"><TR><TD BGCOLOR="#8C8C8C" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">«ganadería»</FONT><BR/><FONT COLOR="white"><B>Produccion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="10">- numero_esquila</FONT><BR/><FONT POINT-SIZE="10">- fecha_esquila</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F2F2F2"><FONT POINT-SIZE="10">+ analisis: AnalisisFibra</FONT></TD></TR></TABLE>>];
  "Enumeraciones" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" COLOR="#5B5B8F" CELLSPACING="0"><TR><TD BGCOLOR="#5B5B8F" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="white">«enumeraciones»</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F3FA"><FONT POINT-SIZE="10"><B>CategoriaProducto</B>: FIBRA, ARTESANAL, SEMI_INDUSTRIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F3FA"><FONT POINT-SIZE="10"><B>EtapaProceso</B>: CLASIFICACION, LAVADO, ESCARMENADO, PEINADO</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F3FA"><FONT POINT-SIZE="10"><B></B>: HILADO, EMPAREJADO, TORCIDO, ENCONADO</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F3FA"><FONT POINT-SIZE="10"><B>TipoFibra</B>: ALPACA, LLAMA, OVINO</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F3FA"><FONT POINT-SIZE="10"><B>UnidadVenta</B>: UNIDAD, KG, LB, MADEJA, OVILLO, ROLLO</FONT></TD></TR></TABLE>>];
  "Lote" -> "Animal" [arrowhead=open, arrowsize=0.7, taillabel="0..*", headlabel="0..1", labeldistance=1.6, labelfontsize=10, label=<<FONT POINT-SIZE="10">animal de origen</FONT>>];
  "Lote" -> "Produccion" [arrowhead=open, arrowsize=0.7, taillabel="0..*", headlabel="0..1", labeldistance=1.6, labelfontsize=10, label=<<FONT POINT-SIZE="10">esquila de origen</FONT>>];
  "Lote" -> "ProcesoLote" [dir=back, arrowtail=diamond, arrowsize=1.1, taillabel="1", headlabel="0..*", labeldistance=1.6, labelfontsize=10];
  "Producto" -> "Lote" [arrowhead=open, arrowsize=0.7, taillabel="0..*", headlabel="0..1", labeldistance=1.6, labelfontsize=10, label=<<FONT POINT-SIZE="10">trazabilidad</FONT>>];
  "Producto" -> "Artesano" [arrowhead=open, arrowsize=0.7, taillabel="0..*", headlabel="0..1", labeldistance=1.6, labelfontsize=10, label=<<FONT POINT-SIZE="10">confeccionado por</FONT>>];
  "Producto" -> "ImagenProducto" [dir=back, arrowtail=diamond, arrowsize=1.1, taillabel="1", headlabel="0..*", labeldistance=1.6, labelfontsize=10];
  "Producto" -> "VarianteProducto" [dir=back, arrowtail=diamond, arrowsize=1.1, taillabel="1", headlabel="1..*", labeldistance=1.6, labelfontsize=10];
  "VarianteProducto" -> "PrecioTemporada" [dir=back, arrowtail=diamond, arrowsize=1.1, taillabel="1", headlabel="0..*", labeldistance=1.6, labelfontsize=10];
  {rank=same; Animal; Produccion; Artesano}
  {rank=same; Producto; Enumeraciones}
}
