digraph "e1_c4_c3_flutter" {
  graph [fontname="Helvetica", fontsize=12, bgcolor=white, pad=0.2, rankdir=TB, nodesep=0.35, ranksep=0.5, newrank=true];
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=10, color="#555555", penwidth=1.1];

  cri [shape=box, style="rounded,filled", fillcolor="#08427B", fontcolor=white, color="#073B6F", label=<<B>Criador</B><BR/><FONT POINT-SIZE="9">[Persona]</FONT>>];
  subgraph cluster_app { label=<<B>App móvil GeneApp</B><BR/><FONT POINT-SIZE="9">[Contenedor: Flutter 3.29 / Dart 3.8]</FONT>>; style="dashed"; color="#333333"; fontsize=13;
    ui [shape=box, style="rounded,filled", fillcolor="#85BBF0", fontcolor="#0B2A4A", color="#5D99D6", label=<<B>Pantallas</B><BR/><FONT POINT-SIZE="9">[ui/features/*/views]</FONT><BR/><FONT POINT-SIZE="10">auth · dashboard · animales · árbol</FONT><BR/><FONT POINT-SIZE="10">esquilas · análisis · reportes · perfil</FONT><BR/><FONT POINT-SIZE="10">sincronización</FONT>>];
    rt [shape=box, style="rounded,filled", fillcolor="#85BBF0", fontcolor="#0B2A4A", color="#5D99D6", label=<<B>Navegación</B><BR/><FONT POINT-SIZE="9">[routes/app_router.dart · GoRouter]</FONT><BR/><FONT POINT-SIZE="10">redirección según la sesión</FONT>>];
    pv [shape=box, style="rounded,filled", fillcolor="#85BBF0", fontcolor="#0B2A4A", color="#5D99D6", label=<<B>Estado</B><BR/><FONT POINT-SIZE="9">[Riverpod providers]</FONT><BR/><FONT POINT-SIZE="10">authProvider · animalProvider</FONT><BR/><FONT POINT-SIZE="10">perfilProvider · syncProvider</FONT>>];
    rp [shape=box, style="rounded,filled", fillcolor="#85BBF0", fontcolor="#0B2A4A", color="#5D99D6", label=<<B>Repositorios</B><BR/><FONT POINT-SIZE="9">[data/repositories]</FONT><BR/><FONT POINT-SIZE="10">AuthRepository · AnimalRepository (API)</FONT><BR/><FONT POINT-SIZE="10">HatoRepository (offline-first)</FONT>>];
    md [shape=box, style="rounded,filled", fillcolor="#85BBF0", fontcolor="#0B2A4A", color="#5D99D6", label=<<B>Modelos</B><BR/><FONT POINT-SIZE="9">[data/models]</FONT><BR/><FONT POINT-SIZE="10">Animal · Produccion · AnalisisFibra</FONT><BR/><FONT POINT-SIZE="10">Consanguinidad · User</FONT>>];
    api [shape=box, style="rounded,filled", fillcolor="#85BBF0", fontcolor="#0B2A4A", color="#5D99D6", label=<<B>Cliente HTTP</B><BR/><FONT POINT-SIZE="9">[data/services/api_service.dart · Dio]</FONT><BR/><FONT POINT-SIZE="10">interceptor JWT con renovación del token</FONT>>];
    sec [shape=box, style="rounded,filled", fillcolor="#85BBF0", fontcolor="#0B2A4A", color="#5D99D6", label=<<B>Almacén seguro</B><BR/><FONT POINT-SIZE="9">[flutter_secure_storage]</FONT><BR/><FONT POINT-SIZE="10">access y refresh token</FONT>>];
    loc [shape=box, style="rounded,filled", fillcolor="#85BBF0", fontcolor="#0B2A4A", color="#5D99D6", label=<<B>Base local</B><BR/><FONT POINT-SIZE="9">[local_store.dart · sqflite]</FONT><BR/><FONT POINT-SIZE="10">animales, esquilas, análisis + sync_status</FONT>>];
    gen [shape=box, style="rounded,filled", fillcolor="#85BBF0", fontcolor="#0B2A4A", color="#5D99D6", label=<<B>Cálculos genealógicos</B><BR/><FONT POINT-SIZE="9">[genealogia.dart]</FONT><BR/><FONT POINT-SIZE="10">COI · árbol · edad, sin red</FONT>>];
    syn [shape=box, style="rounded,filled", fillcolor="#85BBF0", fontcolor="#0B2A4A", color="#5D99D6", label=<<B>Servicio de sincronización</B><BR/><FONT POINT-SIZE="9">[sync_service.dart]</FONT><BR/><FONT POINT-SIZE="10">pendientes · rechazados · last_sync</FONT><BR/><FONT POINT-SIZE="10">connectivity_plus</FONT>>];
  }
  back [shape=box, style="rounded,filled", fillcolor="#438DD5", fontcolor=white, color="#3C7FC0", label=<<B>API REST</B><BR/><FONT POINT-SIZE="9">[Contenedor: Django + DRF]</FONT>>];
  share [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor=white, color="#8A8A8A", label=<<B>Compartir del sistema</B><BR/><FONT POINT-SIZE="9">[share_plus]</FONT><BR/><FONT POINT-SIZE="10">envía CSV / PDF</FONT>>];
  cri -> ui [label="usa"];
  ui -> rt; ui -> pv; pv -> rp; rp -> md; rp -> api; api -> sec;
  rp -> loc; rp -> gen; rp -> syn; syn -> loc; syn -> api;
  api -> back [label="JSON/HTTPS + JWT"];
  ui -> share [label="reportes", style=dashed];

}
