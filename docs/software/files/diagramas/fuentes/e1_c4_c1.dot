digraph "e1_c4_c1" {
  graph [fontname="Helvetica", fontsize=12, bgcolor=white, pad=0.2, rankdir=TB, nodesep=0.6, ranksep=0.9, newrank=true];
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=10, color="#555555", penwidth=1.1];

  cri [shape=box, style="rounded,filled", fillcolor="#08427B", fontcolor=white, color="#073B6F", label=<<B>Criador</B><BR/><FONT POINT-SIZE="9">[Persona]</FONT><BR/><FONT POINT-SIZE="10">personal de campo:</FONT><BR/><FONT POINT-SIZE="10">registra y consulta el hato</FONT>>];
  adm [shape=box, style="rounded,filled", fillcolor="#08427B", fontcolor=white, color="#073B6F", label=<<B>Administrador</B><BR/><FONT POINT-SIZE="9">[Persona]</FONT><BR/><FONT POINT-SIZE="10">usuario único: usuarios,</FONT><BR/><FONT POINT-SIZE="10">tienda, pagos y monitoreo</FONT>>];
  com [shape=box, style="rounded,filled", fillcolor="#08427B", fontcolor=white, color="#073B6F", label=<<B>Comprador</B><BR/><FONT POINT-SIZE="9">[Persona externa]</FONT><BR/><FONT POINT-SIZE="10">compra sin crear cuenta</FONT>>];
  sis [shape=box, style="rounded,filled", fillcolor="#1168BD", fontcolor=white, color="#0B4884", fontsize=14, label=<<B>Sistema Wawa Pacocha</B><BR/><FONT POINT-SIZE="9">[Sistema de software]</FONT><BR/><FONT POINT-SIZE="10">registro genealógico del ganado,</FONT><BR/><FONT POINT-SIZE="10">esquilas y análisis de fibra,</FONT><BR/><FONT POINT-SIZE="10">tienda con trazabilidad y pago manual</FONT>>];
  yape [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor=white, color="#8A8A8A", label=<<B>Yape / Plin</B><BR/><FONT POINT-SIZE="9">[Sistema externo]</FONT><BR/><FONT POINT-SIZE="10">billeteras digitales;</FONT><BR/><FONT POINT-SIZE="10">sin integración automática</FONT>>];
  wsp [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor=white, color="#8A8A8A", label=<<B>WhatsApp</B><BR/><FONT POINT-SIZE="9">[Sistema externo]</FONT><BR/><FONT POINT-SIZE="10">coordinación opcional</FONT>>];
  bak [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor=white, color="#8A8A8A", label=<<B>Almacenamiento externo</B><BR/><FONT POINT-SIZE="9">[Sistema externo]</FONT><BR/><FONT POINT-SIZE="10">copia cifrada de respaldos</FONT>>];
  cri -> sis [label="registra animales, esquilas,\nanálisis; sincroniza"];
  adm -> sis [label="administra usuarios, catálogo,\npedidos y pagos"];
  com -> sis [label="consulta catálogo y trazabilidad,\ngenera y sigue pedidos"];
  com -> yape [label="transfiere el pago"];
  sis -> wsp [label="envía el detalle del pedido", style=dashed];
  sis -> bak [label="copia diaria", style=dashed];
  {rank=same; cri; adm; com}
  {rank=same; yape; wsp; bak}

}
