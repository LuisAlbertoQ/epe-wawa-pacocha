digraph "e2_er_ganaderia" {
  graph [rankdir=TB, fontname="Helvetica", fontsize=20, labelloc=t, nodesep=0.5, ranksep=0.7, pad=0.2, bgcolor=white, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=12];
  edge [color="#555555", penwidth=1.2, arrowsize=1.0, fontname="Helvetica"];
  "usuarios" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>usuarios</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">username</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">is_staff</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">telefono</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">rol</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +10 columnas</I></FONT></TD></TR></TABLE>>];
  "razas" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>razas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">nombre</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">especie</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#8A5A00" POINT-SIZE="10"><B>UK</B> (nombre, especie)</FONT></TD></TR></TABLE>>];
  "animales" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>animales</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">uid</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">char(32)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">arete</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">especie</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">sexo</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">fecha_nacimiento</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">raza</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">sync_status</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">usuario_id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">estado</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">madre_id <I>(opt)</I></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">padre_id <I>(opt)</I></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +9 columnas</I></FONT></TD></TR></TABLE>>];
  "producciones" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>producciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">uid</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">char(32)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">fecha_esquila</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">sync_status</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">animal_id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">numero_esquila</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">longitud_mecha_cm</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">decimal(4,1)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">peso_vellon_lb</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">decimal(6,2)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +3 columnas</I></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#8A5A00" POINT-SIZE="10"><B>UK</B> (animal_id, numero_esquila)</FONT></TD></TR></TABLE>>];
  "analisis_fibra" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>analisis_fibra</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">dmf</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">decimal(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">cv</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">decimal(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">desviacion_estandar</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">decimal(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">factor_confort</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">decimal(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">indice_curvatura</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">decimal(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">fecha_analisis</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT> <FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">produccion_id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +3 columnas</I></FONT></TD></TR></TABLE>>];
  "animales_en_venta" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>animales_en_venta</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">precio</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">proposito</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">titulo</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">destacado</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">orden</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT> <FONT COLOR="#8A5A00"><B>UK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">animal_id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">estado</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">varchar(12)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +3 columnas</I></FONT></TD></TR></TABLE>>];
  "fotos_animal" [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="13"><B>fotos_animal</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#B22222"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"> </TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">orden</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#1B6E20"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB">animal_id</TD><TD ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F4F7FB"><FONT COLOR="#767676" POINT-SIZE="10"><I>… +3 columnas</I></FONT></TD></TR></TABLE>>];
  "usuarios" -> "animales" [dir=both, arrowtail=teetee, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">usuario_id</FONT>>];
  "animales" -> "animales" [dir=both, arrowtail=teeodot, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20"></FONT>>, tailport=w, headport=w];
  "animales" -> "animales" [dir=both, arrowtail=teeodot, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">padre_id / madre_id (opt)</FONT>>, tailport=w, headport=w];
  "animales" -> "producciones" [dir=both, arrowtail=teetee, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">animal_id</FONT>>];
  "producciones" -> "analisis_fibra" [dir=both, arrowtail=teetee, arrowhead=teeodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">produccion_id</FONT>>];
  "animales" -> "animales_en_venta" [dir=both, arrowtail=teetee, arrowhead=teeodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">animal_id</FONT>>];
  "animales" -> "fotos_animal" [dir=both, arrowtail=teetee, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#1B6E20">animal_id</FONT>>];
  {rank=same; usuarios; razas}
  {rank=same; animales; animales_en_venta; fotos_animal}
  {rank=same; producciones; analisis_fibra}
  razas -> animales [style=dashed, arrowhead=none, label=<<FONT POINT-SIZE="10" COLOR="#767676">raza (texto, sin FK)</FONT>>];
}